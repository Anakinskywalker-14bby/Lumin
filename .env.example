# ── Public (safe for the browser — NEXT_PUBLIC_ prefix ONLY here) ──────────
NEXT_PUBLIC_SUPABASE_URL=https://hazjyonpqungkgchqgro.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_gu_DFIdZh9_fhjfjXa1xjQ_I5z_sIbQ
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Server-only secrets (NEVER prefix with NEXT_PUBLIC_) ───────────────────
# Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=
# Stripe Dashboard → Developers → Webhooks → endpoint signing secret
STRIPE_WEBHOOK_SECRET=

# Shared secret between the Next.js server and the Supabase Edge Function
# (set the same value with: supabase secrets set EDGE_TASK_SECRET=...)
EDGE_TASK_SECRET=

# Optional — distributed rate limiting via Upstash Redis (recommended in prod;
# falls back to per-instance in-memory limiter when absent)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
