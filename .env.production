# Committed on purpose: NEXT_PUBLIC_* values are compiled into the client
# bundle and are public by definition. Never add a secret to this file —
# SUPABASE_SERVICE_ROLE_KEY, RESEND_API_KEY and IP_HASH_SALT live only in
# Vercel's encrypted environment variables. CI greps for secret-shaped
# strings and fails the build if one is committed.
#
# This must be a hostname that serves THIS build. It was previously
# lumin-pink.vercel.app, which belongs to the older, non-git-linked Vercel
# project — so canonical tags, the sitemap and OG URLs all pointed at a stale
# site still advertising the removed $1 deposit. Once the lumin-pink alias is
# moved onto the lumin-site project, change this back in one edit.
NEXT_PUBLIC_SITE_URL=https://lumin-site-bay.vercel.app
